# Queries your BOA site via `drush @alias status --pipe` (the same allow-listed command the
# pull uses) and reads the account's PHP-FPM control files with `grep` (also allowed over
# SSH), then writes .ddev/config.boa.yaml so your local project matches the site's PHP
# version, database and Drupal version. This is data-driven parity: it reads BOA's own
# settings, so it tracks the site instead of hand-copying config.
#
# It does NOT reproduce BOA's compiled nginx/PHP builds or per-site php.ini tuning (those
# are not readable through the limited shell) — see README "Scope".
#
# Reads BOA_SSH_USER / BOA_HOST / BOA_ALIAS / BOA_DRUSH from the project env (they live in
# .ddev/providers/boa.yaml). Run `ddev restart` afterwards.

set -eu

_die() { echo "ddev-boa: $1" >&2; exit 1; }

# Read the BOA_* settings from the provider recipe on the host (DDEV injects
# provider environment_variables only during pull/push, not into the web
# container's general environment, so `ddev exec printenv` would be empty here).
_prov="${DDEV_APPROOT:-.}/.ddev/providers/boa.yaml"
_boa_var() {
  sed -n "s/^[[:space:]]*$1:[[:space:]]*//p" "${_prov}" 2>/dev/null | head -1 \
    | sed "s/^[\"']//; s/[\"'][[:space:]]*$//; s/[[:space:]]*$//" | tr -d '\r'
}
_user="$(_boa_var BOA_SSH_USER)"
_host="$(_boa_var BOA_HOST)"
_alias="$(_boa_var BOA_ALIAS)"
_drush="$(_boa_var BOA_DRUSH)"
_drush="${_drush:-drush}"

[ -n "${_user}" ] && [ -n "${_host}" ] && [ -n "${_alias}" ] \
  || _die "set BOA_SSH_USER, BOA_HOST and BOA_ALIAS in .ddev/providers/boa.yaml first."
printf '%s' "${_user}"  | grep -qE '^[A-Za-z0-9._-]+$' || _die "BOA_SSH_USER has invalid characters."
printf '%s' "${_host}"  | grep -qE '^[A-Za-z0-9._-]+$' || _die "BOA_HOST has invalid characters."
printf '%s' "${_alias}" | grep -qE '^[A-Za-z0-9._-]+$' || _die "BOA_ALIAS has invalid characters."
case "${_drush}" in drush|drush8) : ;; *) _drush="drush" ;; esac

# Host commands ssh to the BOA server using your ~/.ssh keys directly; the DDEV
# ssh-agent (ddev auth ssh) is only needed for `ddev pull boa`.

# One allow-listed remote command; unescape JSON slashes for easy matching.
_json="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
  "${_user}@${_host}" "${_drush} @${_alias} status --pipe" 2>/dev/null | sed 's#\\/#/#g' || true)"
printf '%s' "${_json}" | grep -q '"root"' \
  || _die "could not query '@${_alias}' on ${_host} (check BOA_ALIAS with 'ddev boa-aliases')."

_dver="$(printf '%s' "${_json}" | grep -o '"drupal-version"[^,}]*' | head -1 | sed 's/.*: *"//; s/".*//')"
_clinn="$(printf '%s' "${_json}" | grep -oE '/opt/php[0-9]+/'      | head -1 | sed 's#.*/php##; s#/##')"
_dbdrv="$(printf '%s' "${_json}" | grep -o '"db-driver"[^,}]*'     | head -1 | sed 's/.*: *"//; s/".*//')"
_root="$( printf '%s' "${_json}" | grep -o '"root"[^,}]*'          | head -1 | sed 's/.*: *"//; s/".*//')"

# Drush runs on the command-line PHP (cli.info, a phpNN.info marker or a
# cli-per-platform.info line), which can differ from the PHP-FPM version that
# serves the site. Read the web PHP from the account's control files, with the
# rules BOA applies to them: the site's multi-fpm.info line unless BOA lists it
# as waiting in .multi-fpm-skipped.info, else fpm.info (exactly one version).
_ctl="$(ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
  "${_user}@${_host}" "grep -H . static/control/fpm.info static/control/multi-fpm.info static/control/.multi-fpm-skipped.info" 2>/dev/null || true)"
_site="$(printf '%s' "${_alias}" | tr 'A-Z' 'a-z')"
_webnn="$(printf '%s\n' "${_ctl}" | awk -v s="${_site}" '
  function nn(v) { gsub(/[^0-9]/, "", v); return v }
  function nm(v) { gsub(/[^a-zA-Z0-9.-]/, "", v); return tolower(v) }
  {
    i = index($0, ":"); if (i == 0) next
    f = substr($0, 1, i - 1); l = substr($0, i + 1)
    n = split(l, a, " "); k = (n >= 1) ? nm(a[1]) : ""; v = (n >= 2) ? nn(a[2]) : ""
  }
  f == "static/control/fpm.info" { fpm = fpm l }
  f == "static/control/multi-fpm.info" && k == s && v != "" { pin = v }
  f == "static/control/.multi-fpm-skipped.info" && k == s { skip[v] = 1 }
  END {
    if (pin != "" && !(pin in skip)) { print pin; exit }
    gsub(/[^0-9.]/, "", fpm)
    if (fpm ~ /^[0-9][0-9]$/) fpm = substr(fpm, 1, 1) "." substr(fpm, 2, 1)
    if (fpm ~ /^(8\.[0-5]|7\.[0-4]|5\.6)$/) { gsub(/\./, "", fpm); print fpm }
  }')"

# --- translate BOA's reported values into DDEV config ---
# PHP version: the web PHP when readable, else the one Drush ran on; NN -> N.N
_phpnn="${_clinn}"; _phpsrc="cli"
if printf '%s' "${_webnn}" | grep -qE '^[0-9]{2}$'; then
  _phpnn="${_webnn}"; _phpsrc="web"
fi
_php=""; _cli=""
if printf '%s' "${_phpnn}" | grep -qE '^[0-9]{2}$'; then
  _php="${_phpnn%?}.${_phpnn#?}"
fi
if printf '%s' "${_clinn}" | grep -qE '^[0-9]{2}$'; then
  _cli="${_clinn%?}.${_clinn#?}"
fi
# Project type: Drupal major -> ddev type (bare 'drupal' = latest; be explicit otherwise).
_type=""
case "${_dver}" in
  6.*) _type="drupal6" ;;  7.*) _type="drupal7" ;;
  8.*) _type="drupal8" ;;  9.*) _type="drupal9" ;;
  10.*) _type="drupal10" ;; 11.*) _type="drupal11" ;; 12.*) _type="drupal12" ;;
esac
# Database: BOA runs Percona; DDEV's closest match is MySQL of the same series (8.4).
_dbtype="mysql"; _dbver="8.4"
[ "${_dbdrv}" = "pgsql" ] && { _dbtype="postgres"; _dbver="16"; }
# Docroot: BOA composer sites serve from web/ (also docroot/ or html/); else project root.
_docroot=""
case "$(basename "${_root:-}")" in web) _docroot="web" ;; docroot) _docroot="docroot" ;; html) _docroot="html" ;; esac

_out=".ddev/config.boa.yaml"
{
  echo "#ddev-generated by ddev-boa (boa-config) — matches BOA site @${_alias}"
  echo "# Regenerate with: ddev boa-config ; then: ddev restart"
  [ -n "${_type}" ]    && echo "type: ${_type}"
  if [ "${_phpsrc}" = "web" ]; then
    echo "# PHP: the PHP-FPM version that serves the site (from ~/static/control)."
    if [ -n "${_cli}" ] && [ "${_cli}" != "${_php}" ]; then
      echo "# Drush on the server runs on the command-line PHP ${_cli}."
    fi
  elif [ -n "${_php}" ]; then
    echo "# PHP: the command-line version Drush reports; the site's web PHP could"
    echo "# not be read (no fpm.info: the server's default serves the site)."
  fi
  [ -n "${_php}" ]     && echo "php_version: \"${_php}\""
  echo "# The site uses ${_dbtype} ${_dbver} (BOA runs Percona). DDEV's default MariaDB"
  echo "# imports BOA database dumps without trouble, so it is left as-is. To match the"
  echo "# engine exactly, uncomment the lines below BEFORE your first 'ddev start'"
  echo "# (DDEV cannot switch database type once the database has been created):"
  echo "#database:"
  echo "#  type: ${_dbtype}"
  echo "#  version: \"${_dbver}\""
  [ -n "${_docroot}" ] && echo "docroot: ${_docroot}"
} > "${_out}"

echo "ddev-boa: wrote ${_out}:"
sed 's/^/  /' "${_out}"
echo "ddev-boa: review it, then run 'ddev restart' to apply."
[ -n "${_php}" ] || echo "ddev-boa: NOTE — could not detect the site PHP version; set php_version manually."
if [ "${_phpsrc}" = "web" ] && [ -n "${_cli}" ] && [ "${_cli}" != "${_php}" ]; then
  echo "ddev-boa: NOTE — the site serves on PHP ${_php}; Drush on the server runs on PHP ${_cli}."
fi
